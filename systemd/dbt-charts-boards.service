[Unit]
Description=Render dbt Charts boards (charts/*.yml) to the portal at /boards/
# Started by dbt-charts-boards.timer after the daily pipeline window. Each
# board carries its own freshness KPI. (Before Plan 53 a "partial" pipeline run
# exited 1, which is why this is a timer and not an OnSuccess= job.)
# Warehouse lock (PR #92): shared, waits up to an hour for a running writer.

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/oxygen-mvp
ExecStart=/usr/bin/flock -s -w 3600 /home/ubuntu/oxygen-mvp/data/.warehouse.lock /home/ubuntu/oxygen-mvp/scripts/render_boards.sh
Nice=10
IOSchedulingClass=idle
ExecStopPost=-/home/ubuntu/oxygen-mvp/scripts/hc_ping.sh DBT_CHARTS_BOARDS dbt-charts-boards.service
StandardOutput=journal
StandardError=journal
