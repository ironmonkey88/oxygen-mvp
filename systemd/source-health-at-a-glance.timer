[Unit]
Description=Somerville at-a-glance four-times-daily source-health check schedule
Requires=source-health-at-a-glance.service

[Timer]
# 4x/day (was hourly until 2026-10-12): the sources refresh daily, and these
# hours stay clear of the 06:00 ET pipeline run.
OnCalendar=*-*-* 03,09,15,21:25:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
