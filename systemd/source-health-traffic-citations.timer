[Unit]
Description=Somerville traffic-citations four-times-daily source-health check schedule
Requires=source-health-traffic-citations.service

[Timer]
# 4x/day (was hourly until 2026-10-12): the sources refresh daily, and these
# hours stay clear of the 06:00 ET pipeline run.
OnCalendar=*-*-* 03,09,15,21:15:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
